{
  "name": "waku-workspace",
  "type": "module",
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "release": "bun ./scripts/release.ts",
    "protocol:generate": "cargo run -p waku-codegen",
    "protocol:check": "cargo run -p waku-codegen -- --check"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "workspaces": ["website", "apps/*", "packages/*"]
}
